  @@index([tenantId, solicitacaoId])
  @@index([tenantId, aprovadorId])
  @@schema("secp")
}

// -----------------------------------------------------------------------------
// FECHAMENTO MENSAL / HOMOLOGACAO
// -----------------------------------------------------------------------------

model FechamentoMensal {
  id               String           @id @default(cuid())
  tenantId         String
  unidadeId        String
  chefiaId         String?
  recessoId        String?
  ano              Int
  mes              Int
  competencia      String           @db.VarChar(7) // YYYY-MM
  tipo             TipoFechamento   @default(MENSAL_ORDINARIO)
  periodoInicio    DateTime         @db.Date
  periodoFim       DateTime         @db.Date
  status           StatusFechamento @default(ABERTO)
  totalServidores  Int              @default(0)
  totalPendencias  Int              @default(0)
  fechadoEm        DateTime?
  aprovadoChefiaEm DateTime?
  homologadoRhEm   DateTime?
  observacao       String?          @db.Text
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unidade UnidadeOrganizacional @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  chefia  Servidor?             @relation("ChefiaFechamento", fields: [chefiaId], references: [id], onDelete: SetNull)
  recesso RecessoForense?       @relation(fields: [recessoId], references: [id], onDelete: SetNull)

  servidores FechamentoServidor[]

  @@unique([tenantId, unidadeId, ano, mes, tipo])
  @@index([tenantId, competencia])
  @@index([tenantId, unidadeId, status])
  @@index([tenantId, chefiaId, status])
  @@index([periodoInicio, periodoFim])
  @@schema("secp")
}

model FechamentoServidor {
  id                       String           @id @default(cuid())
  tenantId                 String
  fechamentoId             String
  servidorId               String
  jornadaId                String?
  status                   StatusFechamento @default(ABERTO)
  diasUteis                Int              @default(0)
  diasTrabalhados          Int              @default(0)
  faltas                   Int              @default(0)
  atrasosMinutos           Int              @default(0)
  saidasAntecipadasMinutos Int              @default(0)
  trabalhadoMinutos        Int              @default(0)
  previstoMinutos          Int              @default(0)
  saldoMinutos             Int              @default(0)
  bancoHorasMinutos        Int              @default(0)
  pendencias               Int              @default(0)
  cienciaServidorEm        DateTime?
  aprovadoChefiaEm         DateTime?
  homologadoRhEm           DateTime?
  resumo                   Json?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  fechamento FechamentoMensal @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  servidor   Servidor         @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  jornada    JornadaTrabalho? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)

  @@unique([fechamentoId, servidorId])
  @@index([tenantId, servidorId])
  @@index([tenantId, status])
  @@schema("secp")
}

// -----------------------------------------------------------------------------
// AFD / IMPORTACAO
// -----------------------------------------------------------------------------

model ImportacaoAfd {
  id                String              @id @default(cuid())
  tenantId          String
  unidadeId         String?
  dispositivoId     String?
  originalName      String              @db.VarChar(255)
  objectKey         String              @db.Text
  bucket            String?             @db.VarChar(120)
  mimeType          String?             @db.VarChar(80)
  tamanhoBytes      Int?
  checksumSha256    String              @db.VarChar(128)
  status            StatusImportacaoAfd @default(RECEBIDO)
  linhasTotal       Int                 @default(0)
  linhasProcessadas Int                 @default(0)
  linhasErro        Int                 @default(0)
  iniciadoEm        DateTime?
  finalizadoEm      DateTime?
  erro              String?             @db.Text
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linhas LinhaAfd[]

  @@unique([tenantId, checksumSha256])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@schema("importacao")
}

model LinhaAfd {
  id                String         @id @default(cuid())
  tenantId          String
  importacaoId      String
  nsr               Int?
  tipoLinha         TipoLinhaAfd
  status            StatusLinhaAfd @default(PENDENTE)
  numeroLinha       Int
  dataHora          DateTime?
  cpfHash           String?        @db.VarChar(128)
  pisPasepHash      String?        @db.VarChar(128)
  matricula         String?        @db.VarChar(50)
  serialEquipamento String?        @db.VarChar(120)
  rawLine           String         @db.Text
  parsedJson        Json?
  erro              String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  importacao ImportacaoAfd  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  registro   RegistroPonto?

  @@unique([tenantId, importacaoId, numeroLinha])
  @@index([tenantId, importacaoId, status])
  @@index([tenantId, cpfHash, dataHora])
  @@index([tenantId, matricula, dataHora])
  @@index([tenantId, nsr])
  @@schema("importacao")
}

// -----------------------------------------------------------------------------
// ANEXOS / STORAGE / MINIO
// -----------------------------------------------------------------------------

model ArquivoAnexo {
  id              String    @id @default(cuid())
  tenantId        String
  solicitacaoId   String?
  nomeOriginal    String    @db.VarChar(255)
  objectKey       String    @db.Text
  bucket          String    @db.VarChar(120)
  mimeType        String?   @db.VarChar(80)
  tamanhoBytes    Int?
  checksumSha256  String?   @db.VarChar(128)
  criadoPorUserId String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  solicitacao SolicitacaoPonto? @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@index([tenantId, solicitacaoId])
  @@index([tenantId, checksumSha256])
  @@index([deletedAt])
  @@schema("secp")
}

// -----------------------------------------------------------------------------
// NOTIFICACOES / PUSH / WEBHOOKS
// -----------------------------------------------------------------------------

model Notificacao {
  id          String               @id @default(cuid())
  tenantId    String
  userId      String?
  servidorId  String?
  canal       TipoCanalNotificacao
  status      StatusNotificacao    @default(PENDENTE)
  assunto     String               @db.VarChar(180)
  mensagem    String               @db.Text
  payload     Json?
  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?
  erro        String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, status])
  @@index([tenantId, canal, status])
  @@index([scheduledAt])
  @@schema("secp")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId, ativo])
  @@schema("secp")
}

model WebhookEndpoint {
  id            String    @id @default(cuid())
  tenantId      String
  nome          String    @db.VarChar(180)
  url           String    @db.Text
  secretHash    String?   @db.VarChar(128)
  eventos       String[]
  ativo         Boolean   @default(true)
  ultimoEnvioEm DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ativo])
  @@schema("secp")
}

// -----------------------------------------------------------------------------
// API KEYS / INTEGRACOES / IDEMPOTENCIA / OUTBOX
// -----------------------------------------------------------------------------

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String?
  userId     String?
  nome       String    @db.VarChar(180)
  keyHash    String    @unique @db.VarChar(128)
  prefix     String    @db.VarChar(20)
  scopes     String[]
  ativo      Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, ativo])
  @@index([userId, ativo])
  @@schema("secp")
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  tenantId    String?
  key         String   @db.VarChar(180)
  requestHash String   @db.VarChar(128)
  response    Json?
  statusCode  Int?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@schema("secp")
}

model OutboxEvent {
  id            String           @id @default(cuid())
  tenantId      String?
  type          TipoEventoOutbox
  aggregateType String           @db.VarChar(120)
  aggregateId   String           @db.VarChar(120)
  eventName     String           @db.VarChar(180)
  payload       Json
  headers       Json?
  status        StatusOutbox     @default(PENDING)
  attempts      Int              @default(0)
  nextAttemptAt DateTime?
  publishedAt   DateTime?
  erro          String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@index([eventName])
  @@schema("secp")
}

// -----------------------------------------------------------------------------
// AUDITORIA / TRILHA DE SEGURANCA
// -----------------------------------------------------------------------------

model AuditoriaEvento {
  id            String              @id @default(cuid())
  tenantId      String?
  userId        String?
  servidorId    String?
  severidade    SeveridadeAuditoria @default(INFO)
  acao          String              @db.VarChar(180)
  entidade      String              @db.VarChar(120)
  entidadeId    String?             @db.VarChar(120)
  modulo        String?             @db.VarChar(80)
  ip            String?             @db.VarChar(80)
  userAgent     String?             @db.Text
  requestId     String?             @db.VarChar(120)
  correlationId String?             @db.VarChar(120)
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime            @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entidade, entidadeId])
  @@index([userId, createdAt])
  @@index([severidade, createdAt])
  @@index([correlationId])
  @@schema("audit")
}

// -----------------------------------------------------------------------------
// JOBS / PROCESSAMENTO ASSINCRONO - METADADOS DE CONTROLE
// -----------------------------------------------------------------------------

model JobProcessamento {
  id          String    @id @default(cuid())
  tenantId    String?
  fila        String    @db.VarChar(120)
  nome        String    @db.VarChar(180)
  jobKey      String?   @db.VarChar(180)
  payload     Json?
  status      String    @default("PENDING") @db.VarChar(40)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  erro        String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, fila, status])
  @@index([scheduledAt])
  @@schema("secp")
}
