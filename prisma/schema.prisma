// prisma/schema.prisma
// SECP - Sistema Eletrônico de Controle de Ponto
// Arquitetura: Next.js 16+ App Router + Auth.js + Prisma + PostgreSQL + Redis/BullMQ + MinIO + pgvector
// Multi-tenant institucional com isolamento lógico por tenantId e suporte a Auth.js database strategy.

// Observações de produção:
// 1. Todos os modelos de domínio do SECP possuem tenantId.
// 2. O usuário global do Auth.js fica separado do servidor funcional do órgão.
// 3. O perfil MASTER é global/plataforma. Perfis ADMINISTRADOR, GESTOR, SERVIDOR etc. são por tenant.
// 4. Para biometria facial com pgvector, usa-se Unsupported("vector(512)"). Ajuste a dimensão conforme o modelo facial adotado.
// 5. Para isolamento físico por schema/banco por tenant, este schema serve como base lógica; a estratégia pode ser complementada em runtime.

// -----------------------------------------------------------------------------
// GENERATOR / DATASOURCE
// -----------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"

  schemas = ["auth", "secp", "audit", "importacao"]

  // Requer migrations com CREATE EXTENSION correspondente no PostgreSQL.
  extensions = [pgcrypto, citext,  unaccent, uuid_ossp(map: "uuid-ossp"), pgvector(map: "vector")]
}

