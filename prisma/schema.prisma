// -----------------------------------------------------------------------------
// AUTH.JS - SCHEMA auth
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(255)
  email         String?   @unique @db.Citext
  emailVerified DateTime?
  image         String?   @db.Text

  // Campos institucionais globais opcionais. Não substituem o cadastro de Servidor.
  username      String?   @unique @db.Citext
  cpfHash       String?   @unique @db.VarChar(128)
  matricula     String?   @db.VarChar(50)
  telefone      String?   @db.VarChar(30)
  ativo         Boolean   @default(true)
  bloqueadoAte  DateTime?
  ultimoLoginEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts              Account[]
  sessions              Session[]
  authenticators        Authenticator[]
  globalRoles           UserGlobalRole[]
  tenantMemberships     UsuarioTenant[]
  servidorVinculos      Servidor[]
  identidadesExternas   IdentidadeExterna[]
  certificadosDigitais  CertificadoDigitalVinculo[]
  preferenciasDashboard PreferenciaDashboard[]
  auditorias            AuditoriaEvento[]
  notificacoes          Notificacao[]
  pushSubscriptions     PushSubscription[]
  apiKeys               ApiKey[]

  @@index([email])
  @@index([username])
  @@index([cpfHash])
  @@index([ativo])
  @@schema("auth")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@schema("auth")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@schema("auth")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@schema("auth")
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@index([userId])
  @@schema("auth")
}

model UserGlobalRole {
  id        String       @id @default(cuid())
  userId    String
  perfil    PerfilGlobal
  ativo     Boolean      @default(true)
  grantedAt DateTime     @default(now())
  revokedAt DateTime?
  grantedBy String?
  motivo    String?      @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, perfil])
  @@index([perfil, ativo])
  @@schema("auth")
}

model IdentidadeExterna {
  id         String                 @id @default(cuid())
  userId     String
  tenantId   String?
  provider   TipoAuthProviderTenant
  externalId String                 @db.VarChar(255)
  username   String?                @db.Citext
  ldapDn     String?                @db.Text
  metadata   Json?
  ativo      Boolean                @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId, tenantId])
  @@index([userId])
  @@index([tenantId, provider])
  @@schema("auth")
}

model CertificadoDigitalVinculo {
  id               String    @id @default(cuid())
  userId           String
  tenantId         String?
  subject          String    @db.Text
  issuer           String    @db.Text
  serialNumberHash String    @db.VarChar(128)
  thumbprintHash   String    @db.VarChar(128)
  cpfHash          String?   @db.VarChar(128)
  validFrom        DateTime?
  validTo          DateTime?
  ativo            Boolean   @default(true)
  revogadoEm       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serialNumberHash])
  @@index([userId])
  @@index([cpfHash])
  @@index([ativo, validTo])
  @@schema("auth")
}

// -----------------------------------------------------------------------------
// TENANT / GOVERNANCA / LAYOUT
// -----------------------------------------------------------------------------

model Tenant {
  id               String       @id @default(cuid())
  codigo           String       @unique @db.VarChar(50)
  slug             String       @unique @db.Citext
  nome             String       @db.VarChar(255)
  nomeFantasia     String?      @db.VarChar(255)
  sigla            String       @db.VarChar(30)
  cnpjHash         String?      @db.VarChar(128)
  tipo             TipoTenant   @default(SECAO_JUDICIARIA)
  status           StatusTenant @default(EM_IMPLANTACAO)
  timezone         String       @default("America/Manaus") @db.VarChar(80)
  schemaName       String?      @db.VarChar(80)
  dominioPrincipal String?      @db.Citext
  subdominio       String?      @unique @db.Citext
  portariaBase     String?      @db.VarChar(120)
  processoSei      String?      @db.VarChar(80)
  dataImplantacao  DateTime?
  metadata         Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  visualIdentity       TenantVisualIdentity?
  authConfigs          TenantAuthConfig[]
  parametros           ParametroTenant[]
  featureFlags         FeatureFlagTenant[]
  usuarioTenants       UsuarioTenant[]
  identidadesExternas  IdentidadeExterna[]
  certificadosDigitais CertificadoDigitalVinculo[]
  permissoesPerfil     PerfilPermissaoTenant[]
  unidades             UnidadeOrganizacional[]
  tiposUnidade         TipoUnidadeCatalogo[]
  cargos               Cargo[]
  funcoes              FuncaoComissionada[]
  servidores           Servidor[]
  jornadas             JornadaTrabalho[]
  jornadasServidor     JornadaServidor[]
  jornadasUnidade      JornadaUnidade[]
  feriados             Feriado[]
  recessos             RecessoForense[]
  dispositivos         DispositivoPonto[]
  locaisPonto          LocalRegistroPonto[]
  registrosPonto       RegistroPonto[]
  diasPonto            DiaPontoResumo[]
  ocorrenciasPonto     OcorrenciaPonto[]
  solicitacoesPonto    SolicitacaoPonto[]
  fechamentos          FechamentoMensal[]
  importacoesAfd       ImportacaoAfd[]
  templatesBiometria   BiometriaFaceTemplate[]
  notificacoes         Notificacao[]
  webhooks             WebhookEndpoint[]
  apiKeys              ApiKey[]
  auditorias           AuditoriaEvento[]
  outboxEvents         OutboxEvent[]
  anexos               ArquivoAnexo[]

  @@index([status])
  @@index([tipo, status])
  @@index([sigla])
  @@index([deletedAt])
  @@schema("secp")
}

model TenantVisualIdentity {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  appName            String  @default("SECP") @db.VarChar(120)
  loginTitle         String? @db.VarChar(180)
  loginSubtitle      String? @db.VarChar(255)
  logoUrl            String? @db.Text
  logoDarkUrl        String? @db.Text
  faviconUrl         String? @db.Text
  backgroundImageUrl String? @db.Text
  primaryColor       String? @db.VarChar(20)
  accentColor        String? @db.VarChar(20)
  darkModeDefault    Boolean @default(false)
  customCss          String? @db.Text
  layoutConfig       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@schema("secp")
}

model TenantAuthConfig {
  id       String                 @id @default(cuid())
  tenantId String
  provider TipoAuthProviderTenant
  enabled  Boolean                @default(true)
  ordem    Int                    @default(0)
  nome     String?                @db.VarChar(120)

  // Ex.: host AD, baseDN, clientId, issuer, callbackUrl, certificado, políticas etc.
  configEncrypted Json?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, enabled])
  @@schema("secp")
}

model ParametroTenant {
  id                  String   @id @default(cuid())
  tenantId            String
  chave               String   @db.VarChar(120)
  valor               Json
  descricao           String?  @db.Text
  sensivel            Boolean  @default(false)
  atualizadoPorUserId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chave])
  @@index([tenantId])
  @@schema("secp")
}

model FeatureFlagTenant {
  id         String   @id @default(cuid())
  tenantId   String
  chave      String   @db.VarChar(120)
  habilitado Boolean  @default(false)
  config     Json?
  descricao  String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chave])
  @@index([tenantId, habilitado])
  @@schema("secp")
}

model PreferenciaDashboard {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  perfil    String?  @db.VarChar(80)
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, perfil])
  @@index([userId])
  @@schema("secp")
}

// -----------------------------------------------------------------------------
// RBAC POR TENANT
// -----------------------------------------------------------------------------

model UsuarioTenant {
  id                 String               @id @default(cuid())
  tenantId           String
  userId             String
  servidorId         String?
  perfil             PerfilTenant
  status             StatusVinculoUsuario @default(PENDENTE)
  isDefaultTenant    Boolean              @default(false)
  lotacaoPrincipalId String?
  grantedAt          DateTime             @default(now())
  revokedAt          DateTime?
  grantedByUserId    String?
  motivo             String?              @db.Text
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  servidor         Servidor?              @relation(fields: [servidorId], references: [id], onDelete: SetNull)
  lotacaoPrincipal UnidadeOrganizacional? @relation("UsuarioTenantLotacao", fields: [lotacaoPrincipalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, perfil])
  @@index([tenantId, userId])
  @@index([tenantId, perfil, status])
  @@index([servidorId])
  @@index([lotacaoPrincipalId])
  @@schema("secp")
}

model Permissao {
  id        String   @id @default(cuid())
  codigo    String   @unique @db.VarChar(120)
  nome      String   @db.VarChar(180)
  modulo    String   @db.VarChar(80)
  descricao String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perfis PerfilPermissaoTenant[]

  @@index([modulo])
  @@schema("secp")
}

model PerfilPermissaoTenant {
  id          String       @id @default(cuid())
  tenantId    String
  perfil      PerfilTenant
  permissaoId String
  permitido   Boolean      @default(true)
  restricoes  Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, perfil, permissaoId])
  @@index([tenantId, perfil])
  @@schema("secp")
}

// -----------------------------------------------------------------------------
// ORGANIZACAO INSTITUCIONAL / HIERARQUIA
// -----------------------------------------------------------------------------

model TipoUnidadeCatalogo {
  id        String                    @id @default(cuid())
  tenantId  String
  codigo    String                    @db.VarChar(60)
  nome      String                    @db.VarChar(180)
  tipoBase  TipoUnidadeOrganizacional
  natureza  NaturezaUnidade           @default(ADMINISTRATIVA)
  ativo     Boolean                   @default(true)
  ordem     Int                       @default(0)
  metadata  Json?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unidades UnidadeOrganizacional[]

  @@unique([tenantId, codigo])
  @@index([tenantId, ativo])
  @@schema("secp")
}

model UnidadeOrganizacional {
  id             String          @id @default(cuid())
  tenantId       String
  parentId       String?
  tipoCatalogoId String?
  codigo         String          @db.VarChar(80)
  sigla          String          @db.VarChar(50)
  nome           String          @db.VarChar(255)
  nomeCompleto   String?         @db.VarChar(500)
  natureza       NaturezaUnidade @default(ADMINISTRATIVA)
  nivel          Int             @default(0)
  caminho        String?         @db.Text
  ordem          Int             @default(0)
  ativa          Boolean         @default(true)
  permitePonto   Boolean         @default(true)
  processoSei    String?         @db.VarChar(80)
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       UnidadeOrganizacional?  @relation("UnidadeHierarquia", fields: [parentId], references: [id], onDelete: Restrict)
  children     UnidadeOrganizacional[] @relation("UnidadeHierarquia")
  tipoCatalogo TipoUnidadeCatalogo?    @relation(fields: [tipoCatalogoId], references: [id], onDelete: SetNull)

  usuariosLotacao     UsuarioTenant[]      @relation("UsuarioTenantLotacao")
  servidoresLotados   Servidor[]           @relation("ServidorLotacao")
  servidoresExercicio Servidor[]           @relation("ServidorExercicio")
  gestores            UnidadeGestor[]
  jornadas            JornadaUnidade[]
  registrosPonto      RegistroPonto[]
  diasPonto           DiaPontoResumo[]
  ocorrenciasPonto    OcorrenciaPonto[]
  solicitacoesPonto   SolicitacaoPonto[]
  fechamentos         FechamentoMensal[]
  convocacoesRecesso  ConvocacaoRecesso[]
