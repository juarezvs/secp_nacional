  metadata              Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  cargo            Cargo?                 @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  funcao           FuncaoComissionada?    @relation(fields: [funcaoId], references: [id], onDelete: SetNull)
  unidadeLotacao   UnidadeOrganizacional? @relation("ServidorLotacao", fields: [unidadeLotacaoId], references: [id], onDelete: SetNull)
  unidadeExercicio UnidadeOrganizacional? @relation("ServidorExercicio", fields: [unidadeExercicioId], references: [id], onDelete: SetNull)

  usuariosTenant         UsuarioTenant[]
  gestores               UnidadeGestor[]
  jornadas               JornadaServidor[]
  registrosPonto         RegistroPonto[]
  diasPonto              DiaPontoResumo[]
  ocorrenciasPonto       OcorrenciaPonto[]
  solicitacoesPonto      SolicitacaoPonto[]      @relation("SolicitantePonto")
  solicitacoesAnalisadas SolicitacaoPonto[]      @relation("AnalistaPonto")
  aprovacoes             AprovacaoSolicitacao[]
  fechamentosServidor    FechamentoServidor[]
  fechamentosChefia      FechamentoMensal[]      @relation("ChefiaFechamento")
  convocacoesRecesso     ConvocacaoRecesso[]
  diasRecesso            DiaConvocadoRecesso[]
  templatesBiometria     BiometriaFaceTemplate[]
  samplesBiometria       BiometriaFaceSample[]
  afastamentos           AfastamentoServidor[]

  @@unique([tenantId, matricula])
  @@unique([tenantId, cpfHash])
  @@unique([tenantId, userId])
  @@index([tenantId, nome])
  @@index([tenantId, emailInstitucional])
  @@index([tenantId, status])
  @@index([tenantId, unidadeLotacaoId])
  @@index([tenantId, unidadeExercicioId])
  @@index([cargoId])
  @@index([funcaoId])
  @@index([deletedAt])
  @@schema("secp")
}

